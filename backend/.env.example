[TEMPLATE]
# server
NODE_ENV=development
PORT=8000

# browser access — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated additional browser origins if the frontend is deployed elsewhere.
# CLIENT_ORIGIN=https://store.example.com,https://admin.example.com
# Set true only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false
# Auth rate limits use in-process memory; multi-instance deployments need a shared store.

# database — real MongoDB (local or Atlas).
# Leave unset to use the embedded dev database (backend/.mongo-data) instead.
# MONGODB_URI=mongodb://127.0.0.1:27017/fasco

# auth — sign access tokens for login sessions
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# the first admin account, seeded on boot (dashboard login)
ADMIN_EMAIL=admin@fasco.com
ADMIN_PASSWORD=change-me

# email — Gmail SMTP for confirmation / password-reset codes.
# Leave both empty to log the codes to the backend console instead (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FASCO" <no-reply@fasco.com>

# Stripe Checkout test keys. Until both values are configured, checkout stays disabled.
# Use Stripe test-mode keys locally; never place secret keys in frontend variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Google Identity Services (optional). Use the same Web client ID in the frontend.
# Create an OAuth 2.0 Web client and allow the frontend's origin as a JavaScript origin.
# GOOGLE_CLIENT_ID=