[TEMPLATE]
# server
NODE_ENV=development
PORT=8000

# browser access — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated additional browser origins if the frontend is deployed elsewhere.
# CLIENT_ORIGIN=https://store.example.com,https://admin.example.com
# Set true only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false
# Auth rate limits use in-process memory; multi-instance deployments need a shared store.

# database — leave unset to use the persistent local MongoDB under
# %LOCALAPPDATA%\FASCO\mongodb. For MongoDB Community, initialize a single-node
# replica set (rs0) and set MONGODB_URI to its connection string.
# MONGODB_URI=mongodb://127.0.0.1:27017/fasco?replicaSet=rs0

# auth — sign access tokens for login sessions; use a private random value in deployments
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# the first admin account, seeded on boot (dashboard login)
ADMIN_EMAIL=admin@fasco.com
ADMIN_PASSWORD=

# email — Mailtrap Email Testing sandbox for signup verification / password-reset codes.
# Copy the host, port, username, and password from your Mailtrap sandbox's SMTP settings.
# Messages stay in the Mailtrap inbox and are not delivered to real recipient inboxes.
# Never commit this file with real credentials; .env is gitignored.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FASCO" <hello@fasco.test>

# Stripe Checkout test keys. Until both values are configured, checkout stays disabled.
# Use Stripe test-mode keys locally; never place secret keys in frontend variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Google Identity Services (optional). Use the same Web client ID in the frontend.
# Create an OAuth 2.0 Web client and allow the frontend's origin as a JavaScript origin.
# GOOGLE_CLIENT_ID=