[TEMPLATE]
# server
NODE_ENV=development
PORT=8000

CLIENT_ORIGIN=http://localhost:5173

TRUST_PROXY=false




at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# the first admin account, seeded on boot (dashboard login)
ADMIN_EMAIL=admin@fasco.com
ADMIN_PASSWORD="Fasco#Admin123"


