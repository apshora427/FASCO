# Local backend server
NODE_ENV=development
PORT=8000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Local development uses the persistent MongoDB replica set automatically.
# Uncomment only when connecting to your own MongoDB Community replica set.
# MONGODB_URI=mongodb://127.0.0.1:27017/fasco?replicaSet=rs0

# Development-only JWT secret. Production requires a private random secret
# with at least 32 characters. Never use this example value in production.
JWT_SECRET=local-development-secret-change-before-deploying
JWT_EXPIRES_IN=7d

# Admin dashboard account. Set your own values before starting the backend.
# The account is created/synchronized at startup when ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional test email delivery using Mailtrap Email Testing.
# Copy Host, port, username, and password from your Mailtrap sandbox's
# SMTP Settings. Mailtrap captures messages in its inbox; it does not deliver
# them to real recipient mailboxes.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FASCO" <hello@fasco.test>

# Optional Resend delivery (use this instead of SMTP for real inboxes).
# RESEND_API_KEY=
# EMAIL_FROM="FASCO <noreply@your-verified-domain.com>"

# Optional Google Identity Services; use the same Web client ID in the frontend.
# GOOGLE_CLIENT_ID=

# Optional Stripe test-mode credentials. Checkout stays disabled until both
# secret and webhook keys are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
